# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (DO NOT PUT REAL SECRETS HERE)
# Copy this file to .env and fill in your settings.
# See SETUP.md for a step-by-step tutorial on how to get every free key.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. EXECUTION MODE (CLOUD vs LOCAL)
# ------------------------------------------------------------------------------
# BOT_MODE:
#   - 'webhook': for cloud deployment (Render), requires public HTTPS WEBHOOK_URL.
#   - 'polling': for local execution on PC, Mini PC, NAS, or Raspberry Pi.
#                Operates behind any router or firewall without opening ports!
BOT_MODE=polling

# DB_PROVIDER:
#   - 'supabase': Cloud Supabase (PostgreSQL + pgvector + storage bucket)
#   - 'sqlite': 100% Local & Autonomous (data/agente.db + FTS5 + disk storage)
DB_PROVIDER=sqlite
SQLITE_DB_PATH=data/agente.db
LOCAL_STORAGE_DIR=data/storage

# AI_PROVIDER:
#   - 'gemini': Google Gemini Flash Lite (Fast cloud AI with generous free tier)
#   - 'ollama': 100% Local & Offline (requires Ollama running on localhost:11434)
AI_PROVIDER=gemini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Local Runner Options
AUTO_OPEN_BROWSER=false
LOCAL_NOTIFY_ON_BOOT=true

# ------------------------------------------------------------------------------
# 2. TELEGRAM BOT
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz
ALLOWED_TELEGRAM_USER_IDS=123456789
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret

# ------------------------------------------------------------------------------
# 3. GOOGLE GEMINI AI (if AI_PROVIDER=gemini)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSy_your_gemini_api_key
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ------------------------------------------------------------------------------
# 4. SUPABASE (if DB_PROVIDER=supabase)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_secret_key
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
DEFAULT_MATCH_THRESHOLD=0.30

# ------------------------------------------------------------------------------
# 5. SOCIAL & WEB EXTRACTORS (OPTIONAL)
# ------------------------------------------------------------------------------
# Jina AI Reader Bridge (Optional: increases r.jina.ai rate limit)
# JINA_API_KEY=jina_your_api_key

# Instagram cookies from burner/secondary account (NEVER use personal account)
# INSTAGRAM_COOKIES=# Netscape HTTP Cookie File...
# IG_SESSIONID=your_burner_sessionid
# IG_CSRFTOKEN=your_burner_csrftoken
# IG_USER_ID=your_burner_user_id

# RapidAPI Instagram Scraper (Optional fallback, free tier sufficient)
# RAPIDAPI_KEY=your_rapidapi_key
# RAPIDAPI_INSTAGRAM_HOST=instagram-scraper-api2.p.rapidapi.com

# ------------------------------------------------------------------------------
# 6. SERVER & HOSTING
# ------------------------------------------------------------------------------
ENVIRONMENT=development
PORT=8000
WEBHOOK_URL=
